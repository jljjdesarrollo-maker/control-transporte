generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model DailyRecord {
  id          String   @id @default(cuid())
  date        String   // formato YYYY-MM-DD
  km          String?
  production  Float    @default(0)
  libres      Float    @default(0)
  tickets     Float    @default(0)
  cajaComun   Float    @default(0)
  chofex      Float    @default(0)
  ayudante    Float    @default(0)
  diesel      Float    @default(0)
  planRenova  Float    @default(0)
  multaTransito Float  @default(0)
  otherExpenses Float  @default(0)
  otherExpDesc  String?
  totalGastos  Float   @default(0)
  totalIngresos Float  @default(0)
  balance      Float   @default(0)
  photoUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trips Trip[]
}

model Trip {
  id           String  @id @default(cuid())
  recordId     String
  order        Int
  routeFrom    String
  routeTo      String
  time         String?
  income       Float   @default(0)
  boletoLocal  Float   @default(0)
  boletoUrbano Float   @default(0)
  boletoMuni   Float   @default(0)

  record DailyRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
}
